<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ClientTfm)</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>MIR2.ICO</ApplicationIcon>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <BaseOutputPath>..\Build\Client\</BaseOutputPath>
  </PropertyGroup>

  <PropertyGroup>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <NoWarn>1701;1702</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <NoWarn>1701;1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="MIR2.ICO" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Roadmap C4: Direct3D 11 backend ([Graphics] Renderer=D3D11). Same versions as WoOOLcraft's shipped client. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SlimDX">
      <HintPath>..\Components\SlimDX.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Images.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Images.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Images.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Images.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Localization\Chinese.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Localization\English.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\ModernIcons.Lib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="MIR2.ICO">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Starter zip (Release builds): the minimum a new player needs - the program files plus Distribution\Mir2Config.ini
    (patch host + game server) and Distribution\README.txt. The in-game patcher downloads everything else on first start.
    Built from the program files only (never Data\, Map\, Sound\, Patch\, the user's ini or logs in the output folder),
    staged in obj\starter\ and written next to the output folder: Build\Client\CrystalClient.zip for the normal Release build.
    Turn off with -p:StarterZip=false.
  -->
  <PropertyGroup>
    <StarterZip Condition="'$(StarterZip)' == ''">true</StarterZip>
  </PropertyGroup>

  <Target Name="StarterZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(StarterZip)' == 'true'">
    <PropertyGroup>
      <StarterOut>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutDir)'))))</StarterOut>
      <StarterStage>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)starter'))))\</StarterStage>
      <StarterZipPath>$([System.IO.Path]::GetFullPath('$(StarterOut)..\CrystalClient.zip'))</StarterZipPath>
    </PropertyGroup>
    <ItemGroup>
      <StarterFile Include="$(StarterOut)*.exe;$(StarterOut)*.dll;$(StarterOut)Client.deps.json;$(StarterOut)Client.runtimeconfig.json;$(StarterOut)MIR2.ICO" Exclude="$(StarterOut)Old__*" />
      <StarterFile Include="$(StarterOut)runtimes\win-x64\**\*" />
      <StarterFile Include="$(StarterOut)Localization\*.json" />
      <StarterFile Include="$(StarterOut)Resources\**\*" />
      <StarterCopy Include="@(StarterFile)" Rel="$([MSBuild]::MakeRelative('$(StarterOut)', '%(FullPath)'))" />
      <StarterExtra Include="Distribution\Mir2Config.ini;Distribution\README.txt" />
    </ItemGroup>
    <RemoveDir Directories="$(StarterStage)" />
    <Copy SourceFiles="@(StarterCopy)" DestinationFiles="@(StarterCopy->'$(StarterStage)%(Rel)')" />
    <Copy SourceFiles="@(StarterExtra)" DestinationFolder="$(StarterStage)" />
    <ZipDirectory SourceDirectory="$(StarterStage)" DestinationFile="$(StarterZipPath)" Overwrite="true" />
    <Warning Condition="$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Distribution\Mir2Config.ini').Contains('CHANGE_ME'))"
             Text="CrystalClient.zip: Client\Distribution\Mir2Config.ini still has CHANGE_ME values (patch host / server address); set them before sharing the zip." />
    <Message Importance="high" Text="Starter zip: $(StarterZipPath)" />
  </Target>

</Project>