<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>$(ServerTfm)</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <!--
    Procedural dungeons (MirEnvir/DungeonSystem.cs): Crystal.DungeonGen is built in the CrystalStudio repo and vendored here
    by its tools/DungeonPublish (DLL + data\). monsters.json is ours. Both land in <output>\DungeonGen\.
  -->
  <ItemGroup>
    <Reference Include="Crystal.DungeonGen">
      <HintPath>..\Components\DungeonGen\Crystal.DungeonGen.dll</HintPath>
    </Reference>
    <None Include="..\Components\DungeonGen\data\**\*" Link="DungeonGen\data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Components\DungeonGen\monsters.json" Link="DungeonGen\monsters.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Server.WebAdmin.Tests" />
    <InternalsVisibleTo Include="Server.Persistence.Tests" />
    <InternalsVisibleTo Include="MirDbExport" />
    <InternalsVisibleTo Include="MirDbExport.Tests" />
    <InternalsVisibleTo Include="ScratchWorld" />
    <InternalsVisibleTo Include="Server" />
  </ItemGroup>

</Project>