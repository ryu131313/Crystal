<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StressClient (roadmap P6): headless load-test bots that speak the real Crystal protocol through
    the Shared codec (Packet.IsServer = false). For SCRATCH servers only (see
    Knowledgebase/StressClient/stressclient.md). Builds to its own bin\ (never Build\).
    Rebuild it after every Shared/ change, like the client and the server.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ServerTfm)</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>StressClient</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>StressClient.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
